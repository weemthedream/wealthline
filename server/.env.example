# Copy to .env for local development; set the same names as environment
# variables in your host's dashboard (e.g. Vercel Project Settings > Environment Variables).

# Postgres connection string. Get a free one from https://neon.tech
# (create a project, copy the "pooled connection" string).
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The exact origin your frontend is served from (needed for cross-site cookies).
# Not needed if the backend also serves the built frontend (same-origin) —
# which is the case both for the Docker image and for the Vercel deployment.
CORS_ORIGIN=http://localhost:5173

# Port the API server listens on locally. Ignored on Vercel.
PORT=4000

# Set to "production" when deploying so cookies are marked Secure (requires HTTPS).
NODE_ENV=production
